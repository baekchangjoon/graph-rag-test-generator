<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- DB seed INSERT (per row) -->
    <logger name="io.graphrag.builder.run.Seeds" level="INFO"/>

    <!-- Happy/variant synthesis summary + state-guard pass -->
    <logger name="io.graphrag.builder.run.EndpointExplorationRunner" level="INFO"/>

    <!-- Read-path seed/body synthesis detail -->
    <logger name="io.graphrag.builder.run.ReadInputSynthesizer" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
