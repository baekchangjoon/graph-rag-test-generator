# graph-rag 생성 테스트의 런타임 환경변수 예시
#
# 사용:
#   export $(grep -v '^#' examples/env/test-runtime.env | xargs)
#   # 그 다음 생성된 테스트 실행

# === SUT 접속 (RestAssured baseURI) ===
APP_BASE_URI=http://localhost:8080

# === DB (운영 DBMS와 동일 버전 권장) ===
JDBC_URL=jdbc:postgresql://localhost:5432/app
JDBC_USER=app
JDBC_PASS=app

# === 외부 mock 서비스 ===
# WireMock admin
HTTP_MOCK_ADMIN=http://localhost:9091
# socket-mock-server admin
SOCKET_MOCK_ADMIN=http://localhost:9099

# === 대시보드 (선택) ===
# 설정 안 하면 testlib는 noop reporter 사용
DASHBOARD_URL=http://localhost:8099

# === 인증 ===
# disabled 시 SUT의 인증을 꺼둔 환경 가정
# real 시 토큰 발급 코드가 생성된 테스트에 포함
TEST_AUTH_MODE=disabled
AUTH_BASE_URI=http://localhost:8080/auth

# === OTEL baggage 격리 키 ===
OTEL_BAGGAGE_KEY=test-id

# === 어댑터 선택 (선택, 기본은 default 어댑터) ===
# HTTP_MOCK_ADAPTER=wiremock
# SOCKET_MOCK_ADAPTER=netty-custom
# AUTH_ADAPTER=oauth2-pwd
# DASHBOARD_ADAPTER=http
